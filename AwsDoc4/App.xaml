<Application
    x:Class="AwsDoc4.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AwsDoc4"
    xmlns:v="clr-namespace:AwsDoc4.Views"
    xmlns:wpf="http://materialdesigninxaml.net/winfx/xaml/themes"
    Exit="Application_Exit"
    Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <wpf:MahAppsBundledTheme
                    BaseTheme="Inherit"
                    ColorAdjustment="{wpf:ColorAdjustment}"
                    PrimaryColor="DeepPurple"
                    SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.MahApps;component/Themes/MaterialDesignTheme.MahApps.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- string -->
            <v:NullableBoolConverter x:Key="NullableBoolConverter"/>
            <v:JsonToStringConverter x:Key="JsonToStringConverter"/>

            <DataTemplate x:Key="StringTemplate">
                <TextBox wpf:HintAssist.Hint="{Binding Attr.Name}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="4" Text="{Binding Value}" IsReadOnly="True"/>
            </DataTemplate>

            <!-- bool -->
            <DataTemplate x:Key="BoolTemplate">
                <StackPanel Margin="4" Orientation="Horizontal">
                    <ToggleButton HorizontalAlignment="Left"
                    IsChecked="{Binding Value}"
                    IsHitTestVisible="False"
                    IsThreeState="{Binding PropertyType, Converter={StaticResource NullableBoolConverter}}" />
                    <TextBlock Text="{Binding Attr.Name}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <!-- json -->
            <DataTemplate x:Key="JsonTemplate">
                <TextBox Margin="4" AcceptsReturn="True" AcceptsTab="True"
                             IsReadOnly="True"
                             MaxHeight="400"
                             VerticalScrollBarVisibility="Auto"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Left"
                             Text="{Binding Value, Converter={StaticResource JsonToStringConverter}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             wpf:HintAssist.Hint="{Binding Attr.Name}">
                </TextBox>
            </DataTemplate>

            <!-- Selector -->
            <v:PropertyTemplateSelector x:Key="PropertyTemplateSelector"
            StringTemplate="{StaticResource StringTemplate}"
            BoolTemplate="{StaticResource BoolTemplate}"
            JsonTemplate="{StaticResource JsonTemplate}" />

            <Style
                x:Key="PageTitleTextBlock"
                BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>

            <Style
                x:Key="PageSectionTitleTextBlock"
                BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="PageSectionSeparator" TargetType="Rectangle">
                <Setter Property="Margin" Value="0,24" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{DynamicResource MaterialDesignDivider}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
