<UserControl x:Class="AwsDoc4.Views.SummaryBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mahApps="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:wpf="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:v="clr-namespace:AwsDoc4.Views"
    xmlns:vm="clr-namespace:AwsDoc4.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ToolBar Margin="4">
            <TextBox Width="400" Margin="4" Text="{Binding ExcelPath.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" wpf:HintAssist.Hint="保存先"/>
            <Button Margin="4" Command="{Binding SaveDlgCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}">
                <wpf:PackIcon Kind="Floppy"/>
            </Button>
            <Button Margin="4" Command="{Binding ExecuteCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryLightButton}">
                <wpf:PackIcon Kind="LightningBolt"/>
            </Button>
        </ToolBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Style="{StaticResource MaterialDesignCardGroupBox}" Header="一覧">
                <Grid>
                    <ListView ItemsSource="{Binding FilteredView}" SelectedItem="{Binding SelectedResource.Value,UpdateSourceTrigger=PropertyChanged}">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="タイプ" DisplayMemberBinding="{Binding Resource.Value.Type,Mode=OneWay}"/>
                                    <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Resource.Value.Name,Mode=OneWay}"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button Margin="10" Command="{Binding AddResourceCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryLightButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <wpf:PackIcon Kind="Add" />
                    </Button>
                    <Button Margin="10,10,60,10" Command="{Binding RemoveSelectedResourceCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryLightButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <wpf:PackIcon Kind="Remove" />
                    </Button>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <GroupBox Grid.Column="2" Style="{StaticResource MaterialDesignCardGroupBox}" Header="詳細" wpf:ColorZoneAssist.Mode="SecondaryLight">
                <ContentControl Content="{Binding SelectedResource.Value}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <v:AwsResourceBox DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                    <!--<ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:APIGatewayBoxViewModel}">
                            <v:APIGatewayBox DataContext="{Binding}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AppSyncBoxViewModel}">
                            <v:AppSyncBox DataContext="{Binding}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AuroraBoxViewModel}">
                            <v:AuroraBox DataContext="{Binding}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:LambdaBoxViewModel}">
                            <v:LambdaBox DataContext="{Binding}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:S3BoxViewModel}">
                            <v:S3Box DataContext="{Binding}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SQSBoxViewModel}">
                            <v:SQSBox DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.Resources>-->
                </ContentControl>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
